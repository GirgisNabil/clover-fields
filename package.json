    "howler": "2.2.4",
    "idb-keyval": "6.3.0",
    "immer": "11.2.9",
    "lucide-react": "1.69.0",
    "motion": "14.9.1",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
