    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "leva": "0.10.1",
    "meshoptimizer": "1.3.0",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
