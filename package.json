    "assets:fetch": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/assets/fetch.ts",
    "assets:build": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/assets/build.ts",
    "assets:inspect": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/assets/inspect.ts"
  },
