{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!raw-assets",
      "!public",
      "!test-results",
      "!playwright-report",
      "!src/game/assets/manifest.ts",
      "!src/app/shadcn-tailwind.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "src/domain must stay pure (no React).",
                  "react-dom": "src/domain must stay pure (no React).",
                  "zustand": "src/domain must stay pure (no stores).",
                  "idb-keyval": "src/domain must stay pure (no persistence).",
                  "three": "src/domain must stay pure (no rendering).",
                  "@react-three/fiber": "src/domain must stay pure (no rendering).",
                  "next": "src/domain must stay pure (no framework)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    }
  ]
}
